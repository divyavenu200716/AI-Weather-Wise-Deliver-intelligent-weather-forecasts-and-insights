Corresponding MongoDB model
If you're using the first diagram, create:

src/models/weatherModel.js

const mongoose = require("mongoose");

const weatherSchema = new mongoose.Schema(
  {
    city: {
      type: String,
      required: true,
      trim: true
    },

    country: {
      type: String,
      trim: true
    },

    temperature: {
      type: Number,
      required: true
    },

    humidity: {
      type: Number,
      required: true
    },

    description: {
      type: String
    },

    aiRecommendation: {
      type: String
    },

    userId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: "User"
    }
  },
  {
    timestamps: true
  }
);

module.exports = mongoose.model("Weather", weatherSchema);

For your current project, I recommend the simpler diagram if you haven't implemented login/users yet. It keeps the ER diagram consistent with the actual code rather than documenting tables/collections that don't exist yet.
