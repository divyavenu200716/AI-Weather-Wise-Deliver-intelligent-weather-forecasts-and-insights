6. Weather service
The service layer communicates with the external weather API.

src/services/weatherService.js
const axios = require("axios");

const getWeatherFromAPI = async (city) => {
  const url = "https://api.openweathermap.org/data/2.5/weather";

  const response = await axios.get(url, {
    params: {
      q: city,
      appid: process.env.WEATHER_API_KEY,
      units: "metric"
    }
  });

  return {
    city: response.data.name,
    country: response.data.sys.country,
    temperature: response.data.main.temp,
    humidity: response.data.main.humidity,
    description: response.data.weather[0].description
  };
};

module.exports = {
  getWeatherFromAPI
};

7. AI service
For the first version, you can keep the AI logic simple. Later you can connect an actual AI API.

src/services/aiService.js
const generateRecommendation = async (weather) => {
  const { temperature, humidity, description } = weather;

  let recommendation;

  if (temperature >= 35) {
    recommendation =
      "It is very hot today. Stay hydrated and avoid prolonged exposure to direct sunlight.";
  } else if (temperature <= 15) {
    recommendation =
      "The weather is cool. Consider wearing warm clothing when going outside.";
  } else if (description.toLowerCase().includes("rain")) {
    recommendation =
      "Rain is expected. Carry an umbrella and consider waterproof clothing.";
  } else {
    recommendation =
      "The weather looks comfortable. It should be a good time for outdoor activities.";
  }

  return recommendation;
};

module.exports = {
  generateRecommendation
};

This gives you an AI-like recommendation layer for the initial project. You can replace this function later with an actual LLM API.

8. Controller
src/controllers/weatherController.js
const Weather = require("../models/weatherModel");

const {
  getWeatherFromAPI
} = require("../services/weatherService");

const {
  generateRecommendation
} = require("../services/aiService");

const getWeather = async (req, res, next) => {
  try {
    const { city } = req.query;

    if (!city) {
      return res.status(400).json({
        success: false,
        message: "City is required"
      });
    }

    // Get weather information
    const weather = await getWeatherFromAPI(city);

    // Generate recommendation
    const recommendation = await generateRecommendation(weather);

    // Save result
    const savedWeather = await Weather.create({
      ...weather,
      aiRecommendation: recommendation
    });

    res.status(200).json({
      success: true,
      data: savedWeather
    });
  } catch (error) {
    next(error);
  }
};

module.exports = {
  getWeather
};

